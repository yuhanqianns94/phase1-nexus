{
  "name": "Phase I Toxicity v3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -c requirements-deploy.txt -e './v3[test]'",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Phase I website preview",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "JAX_PLATFORMS": "cpu",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
